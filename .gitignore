# Python bytecode
__pycache__/
*.py[codz]
*$py.class
*.so

# Build artifacts (Python and frontend both produce dist/)
build/
dist/
*.egg-info/
*.egg

# Test / lint / coverage caches
.pytest_cache/
.ruff_cache/
.eslintcache
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environment files and virtualenvs
.env
.envrc
.venv
venv/

# Logs
*.log

# Frontend
node_modules/
.vite/

# OS
.DS_Store
Thumbs.db

# SQLite (rebuilt by `make ingest`)
data/*.db
data/*.db-*

# FHIR dataset (downloaded externally; see README)
data/dataset/*
!data/dataset/.gitkeep

# Profiling
# Ad-hoc *.prof files at the repo root are ignored;
# backend/benchmarks/*.prof are checked in as demo artifacts.
*.prof
!backend/benchmarks/*.prof
